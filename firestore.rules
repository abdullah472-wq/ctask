rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════════════════
    // HELPER FUNCTIONS
    // ═══════════════════════════════════════════════════════════════════════════

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );
    }

    function isParticipant(participants) {
      return isSignedIn() && request.auth.uid in participants;
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // 1. USERS
    // ═══════════════════════════════════════════════════════════════════════════
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isSignedIn();
      allow delete: if isAdmin();

      // Subcollections
      match /followers/{followerId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }

      match /following/{followingId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }

      match /blocked_users/{blockedId} {
        allow read, write: if isOwner(userId);
      }

      match /saved_profiles/{workerId} {
        allow read, write: if isOwner(userId);
      }

      match /notifications/{notifId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /team_members/{memberId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /claimed_achievements/{achievementId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /personal_emergency/{contactId} {
        allow read, write: if isOwner(userId);
      }

      // ✅ NEW: Saved posts/jobs
      match /saved_posts/{postId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // 2. POSTS
    // ═══════════════════════════════════════════════════════════════════════════
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn(); // Allow analytics updates
      allow delete: if isOwner(resource.data.ownerId) || isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // 3. NOTIFICATIONS (Global)
    // ═══════════════════════════════════════════════════════════════════════════
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.toUserId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.toUserId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.toUserId == request.auth.uid;
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // 4. HIRE REQUESTS
    // ═══════════════════════════════════════════════════════════════════════════
    match /hire_requests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // 5. JOB APPLICATIONS ✅ NEW
    // ═══════════════════════════════════════════════════════════════════════════
    match /job_applications/{applicationId} {
      allow read: if isSignedIn() && (
        resource.data.applicantId == request.auth.uid ||
        resource.data.postOwnerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.applicantId == request.auth.uid ||
        resource.data.postOwnerId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // 6. ONGOING JOBS
    // ═══════════════════════════════════════════════════════════════════════════
    match /ongoing_jobs/{jobId} {
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.participants ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.participants
      );
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // 7. COMPLETED JOBS
    // ═══════════════════════════════════════════════════════════════════════════
    match /completed_jobs/{jobId} {
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.participants ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.participants
      );
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // 8. TEAM INVITATIONS ✅ NEW - এটাই মিসিং ছিল!
    // ═══════════════════════════════════════════════════════════════════════════
    match /team_invitations/{invitationId} {
      // Read: sender অথবা receiver পড়তে পারবে
      allow read: if isSignedIn() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid ||
        isAdmin()
      );

      // Create: logged in user invite পাঠাতে পারবে
      allow create: if isSignedIn() &&
        request.resource.data.fromUserId == request.auth.uid;

      // Update: receiver accept/reject করতে পারবে, sender cancel করতে পারবে
      allow update: if isSignedIn() && (
        resource.data.toUserId == request.auth.uid ||
        resource.data.fromUserId == request.auth.uid
      );

      // Delete: sender বা receiver delete করতে পারবে
      allow delete: if isSignedIn() && (
        resource.data.toUserId == request.auth.uid ||
        resource.data.fromUserId == request.auth.uid ||
        isAdmin()
      );
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // 9. TEAMS ✅ NEW
    // ═══════════════════════════════════════════════════════════════════════════
    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        request.auth.uid in resource.data.members ||
        request.auth.uid in resource.data.managers ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );

      // Team members subcollection
      match /members/{memberId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // 11. REVIEWS
    // ═══════════════════════════════════════════════════════════════════════════
    match /reviews/{reviewId} {
      allow read: if true; // Public readable
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.reviewerId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // 12. USER STATS
    // ═══════════════════════════════════════════════════════════════════════════
    match /user_stats/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // 13. EMERGENCY
    // ═══════════════════════════════════════════════════════════════════════════
    match /emergency_directory/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /emergency_requests/{id} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // 14. ADS & CONFIG
    // ═══════════════════════════════════════════════════════════════════════════
    match /ads/{adId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /appConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ✅ NEW: App Settings
    match /app_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // 15. PAYMENTS & REPORTS
    // ═══════════════════════════════════════════════════════════════════════════
    match /payment_requests/{id} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (
        resource.data.reporterId == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // 16. BACKEND / ADMIN
    // ═══════════════════════════════════════════════════════════════════════════
    match /withdrawals/{id} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    match /support_tickets/{ticketId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /referrals/{referralId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (
        resource.data.referrerId == request.auth.uid ||
        resource.data.referredId == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // 17. ACHIEVEMENTS
    // ═══════════════════════════════════════════════════════════════════════════
    match /achievements/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /weekly_progress/{docId} {
      allow read, write: if isSignedIn();
    }

    match /daily_progress/{docId} {
      allow read, write: if isSignedIn();
    }

    // ✅ NEW: Long-term achievements
    match /longterm_progress/{docId} {
      allow read, write: if isSignedIn();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // 18. BADGES ✅ NEW
    // ═══════════════════════════════════════════════════════════════════════════
    match /badges/{badgeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /user_badges/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // 19. FCM TOKENS ✅ NEW
    // ═══════════════════════════════════════════════════════════════════════════
    match /fcm_tokens/{tokenId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // 20. SAVED WORKERS / SAVED JOBS ✅ NEW
    // ═══════════════════════════════════════════════════════════════════════════
    match /saved_workers/{docId} {
      allow read, write: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
    }

    match /saved_jobs/{docId} {
      allow read, write: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // 21. ANALYTICS ✅ NEW
    // ═══════════════════════════════════════════════════════════════════════════
    match /analytics/{docId} {
      allow read: if isAdmin();
      allow write: if isSignedIn();
    }

    match /post_analytics/{postId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // 23. SUBSCRIPTIONS ✅ NEW
    // ═══════════════════════════════════════════════════════════════════════════
    match /subscriptions/{subId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // 24. VERIFICATION / KYC ✅ NEW
    // ═══════════════════════════════════════════════════════════════════════════
    match /kyc_requests/{kycId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // 25. FEEDBACK ✅ NEW
    // ═══════════════════════════════════════════════════════════════════════════
    match /feedback/{feedbackId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // 26. SEARCH HISTORY ✅ NEW
    // ═══════════════════════════════════════════════════════════════════════════
    match /search_history/{docId} {
      allow read, write: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
    }

    // ═══════════════════════════════════════════════════════════════════════════
    // 27. WALLET / COINS ✅ NEW
    // ═══════════════════════════════════════════════════════════════════════════
    match /wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isSignedIn(); // Server functions can update
    }

    match /wallet_transactions/{transactionId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

  }
}